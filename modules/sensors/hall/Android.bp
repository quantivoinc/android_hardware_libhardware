package {
    default_applicable_licenses: ["hardware_libhardware_license"],
}

// Standalone sensors sub-HAL. List the installed .so in
// /vendor/etc/sensors/hals.conf so multihal dlopens it next to the primary HAL.
cc_library_shared {
    name: "sensors.hall",
    vendor: true,
    relative_install_path: "hw",

    srcs: [
        "HallContext.cpp",
        "HallSubHal.cpp",
    ],

    header_libs: [
        "libhardware_headers",
        "android.hardware.sensors@2.X-multihal.header",
        "android.hardware.sensors@2.X-shared-utils",
    ],

    shared_libs: [
        "liblog",
        "libcutils",
        "libhidlbase",
        "libutils",
        "android.hardware.sensors@2.0",
        "android.hardware.sensors@2.0-ScopedWakelock",
        "android.hardware.sensors@2.1",
    ],

    static_libs: [
        "android.hardware.sensors@1.0-convert",
    ],

    cpp_std: "c++20",

    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
}
